# Shared HackBarna identity. All four values are server-only secrets/configuration.
# Register a separate confidential OIDC client for local, preview and production.
HACKBARNA_OIDC_CLIENT_ID=
HACKBARNA_OIDC_CLIENT_SECRET=
HACKBARNA_OIDC_REDIRECT_URI=http://localhost:8888/auth/callback
# 32 cryptographically random bytes, encoded as 64 hex characters.
HACKBARNA_SESSION_KEY=
# Optional; default is the canonical issuer advertised by Digest's provider.
# HACKBARNA_OIDC_ISSUER=https://usfkgslefvtrtlwexnfo.supabase.co/auth/v1

# PostHog analytics. Public values, configured per Netlify build context.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Project claims: server-only, with a separate lookup key for each environment.
# 32 random bytes encoded as 64 hex characters; never reuse the session key.
HACKBARNA_PROJECT_CLAIM_KEY=
# Comma-separated, verified Digest account UUIDs allowed to review/import claims.
HACKBARNA_ORGANISER_IDS=

# Optional extra organiser-reviewed OAuth clients allowed to use the shared
# community-profile API. The website's own configured client is already allowed;
# direct Digest sessions use the same issuer and need no additional client ID.
# HACKBARNA_PROFILE_CLIENT_IDS=

# Optional review alerts. Set these only in Netlify's production Functions context.
# Posting-only incoming webhook for the picsoung workspace / #hackbarna channel.
# Never prefix these with NEXT_PUBLIC_ or put the webhook URL in source control.
HACKBARNA_REVIEW_NOTIFICATIONS_ENABLED=false
HACKBARNA_REVIEW_SLACK_WEBHOOK=
# Separate random 32-byte secret encoded as 64 hex characters for the cron bridge.
HACKBARNA_REVIEW_DISPATCH_TOKEN=

# Private account communication preference -> Resend contact property.
# Production Functions only. Never use NEXT_PUBLIC_ for these values.
HACKBARNA_CONTACT_SYNC_ENABLED=false
HACKBARNA_RESEND_API_KEY=
HACKBARNA_CONTACT_DISPATCH_TOKEN=

# Stable, independent 32-byte secret encoded as 64 hex characters. Keep this key
# across releases so existing invitation opt-out links and suppressions remain valid.
HACKBARNA_INVITATION_KEY=
